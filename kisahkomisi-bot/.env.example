# Telegram Bot Token dari @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Telegram User ID / Chat ID yang diizinkan (opsional, pisahkan koma jika banyak)
# Kosongkan jika ingin bot bisa diakses publik
ALLOWED_USERS=

# Path database SQLite (default: ./data/kisahkomisi.db)
DB_PATH=./data/kisahkomisi.db

# Environment (development / production)
NODE_ENV=development
